# no.1-agent-workbench Terraform variables example
# 実際の OCID と SSH public key に置き換えて使用してください。

compartment_ocid     = "ocid1.compartment.oc1..example"
availability_domain  = "xxxx:AP-TOKYO-1-AD-1"
vcn_id               = "ocid1.vcn.oc1.ap-tokyo-1.example"
subnet_id            = "ocid1.subnet.oc1.ap-tokyo-1.example"
ssh_authorized_keys  = "ssh-ed25519 AAAA... opc@example"
assign_public_ip     = false

# Compute default は VM.Standard.E5.Flex / 2 OCPU / 24GB RAM / 100GB boot volume です。
instance_display_name       = "agent-workbench"
instance_shape              = "VM.Standard.E5.Flex"
instance_flex_shape_ocpus   = 2
instance_flex_shape_memory  = 24
instance_boot_volume_size   = 100
instance_boot_volume_vpus   = 10
instance_image_ocid         = ""

# 新規 ADB を作成する場合。password は /, @, ダブルクォート、改行を含めないでください。
adb_deployment_mode = "新規 Autonomous AI Database の作成"
adb_name            = "AGENTADB"
adb_workload        = "LH"
adb_db_version      = "26ai"
adb_password        = "ChangeMe12345"

# ADB ACL は既定で VCN/subnet を許可します。
adb_network_access_type          = "SECURE_ACCESS_FROM_ALLOWED_IPS_AND_VCNS"
adb_acl_notation_type            = "VCN"
adb_acl_vcn_id                   = ""
adb_acl_subnet_id                = ""
adb_is_mtls_connection_required  = true

# Codex CLI は既定で @openai/codex@latest です。
codex_cli_version       = "latest"
nodejs_release_base_url = "https://nodejs.org/download/release/latest-v24.x"
sqlcl_download_url      = "https://download.oracle.com/otn_software/java/sqldeveloper/sqlcl-latest.zip"
uv_version              = ""
openai_api_key          = ""
